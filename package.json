{
  "name": "sirup.gg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One MCP endpoint that aggregates every MCP server your company uses.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "npm run typecheck && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -b --force",
    "migrate": "knex --knexfile knexfile.ts migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.ts migrate:rollback",
    "migrate:make": "knex --knexfile knexfile.ts migrate:make",
    "test": "npm run typecheck && npm run check:build && npm run check:surfaces && npm run check:catalog && npm run check:connect-flow && npm run check:multi-account && npm run check:profiles && npm run check:connection && npm run check:smoke && npm run check:regression && npm run check:pagination && npm run check:pool && npm run check:timestamps && npm run check:indexes && npm run check:route",
    "check:build": "tsx scripts/check-build.ts",
    "check:connection": "tsx scripts/check-connection.ts",
    "check:smoke": "tsx scripts/smoke.ts",
    "check:regression": "tsx scripts/regression.ts",
    "check:pagination": "tsx scripts/check-pagination.ts",
    "check:pool": "tsx scripts/check-pool.ts",
    "check:timestamps": "tsx scripts/check-timestamps.ts",
    "check:indexes": "tsx scripts/check-indexes.ts",
    "check:route": "tsx scripts/check-mcp-route.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:traffic": "tsx scripts/exercise-gateway.ts",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:schema": "tsx scripts/inspect-schema.ts",
    "pg:dev": "tsx scripts/pg-dev.ts",
    "gen:icons": "tsx scripts/gen-icons.ts",
    "check:catalog": "tsx scripts/check-catalog.ts",
    "check:connect-flow": "tsx scripts/check-connect-flow.ts",
    "check:surfaces": "tsx scripts/check-surfaces.ts",
    "gen:app-icons": "tsx scripts/gen-app-icons.ts",
    "check:multi-account": "tsx scripts/check-multi-account.ts",
    "check:profiles": "tsx scripts/check-profiles.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cross-env": "^10.1.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "lucide-react": "^0.511.0",
    "objection": "^3.1.5",
    "pg": "^8.16.3",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "simple-icons": "^16.29.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.20.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "embedded-postgres": "18.4.0-beta.17",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  }
}
