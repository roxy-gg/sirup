{
  "name": "sirup.gg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One MCP endpoint that aggregates every MCP server your company uses.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development node server/index.js",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "seed": "knex seed:run",
    "test": "node scripts/check-build.js && node scripts/check-connection.js && node scripts/smoke.js && node scripts/regression.js && node scripts/check-pagination.js && node scripts/check-pool.js && node scripts/check-timestamps.js && node scripts/check-indexes.js && node scripts/check-mcp-route.js",
    "seed:demo": "node scripts/seed-demo.js",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:schema": "node scripts/inspect-schema.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "lucide-react": "^0.511.0",
    "objection": "^3.1.5",
    "pg": "^8.16.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.0"
  }
}
