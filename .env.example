# Copy to .env for local development. In Dokploy, set these in the
# Environment tab instead — do not commit a real .env.

# ─── Required in production ───────────────────────────────────────────────

# Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Postgres password. Used by both the db and app services in compose.
POSTGRES_PASSWORD=

# ─── Database ─────────────────────────────────────────────────────────────

# Defaults to postgres://sirup:sirup@localhost:5432/sirup, which matches
# docker-compose.dev.yml. Compose builds this from the POSTGRES_* values.
DATABASE_URL=

POSTGRES_USER=sirup
POSTGRES_DB=sirup

# "true" only for a managed provider that requires TLS. A same-host Postgres
# on a private Docker network does not need it.
DATABASE_SSL=false

DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── App ──────────────────────────────────────────────────────────────────

# 5173 locally; the container listens on 3000.
PORT=5173

# How long an upstream MCP call may take before the gateway gives up.
UPSTREAM_TIMEOUT_MS=30000

# ─── Managed OAuth integrations ───────────────────────────────────────────

# Public origin for OAuth callbacks. Register this exact Gmail redirect URI:
#   ${APP_ORIGIN}/api/integrations/oauth/callback
APP_ORIGIN=http://localhost:5173

# Encrypts OAuth access and refresh tokens at rest. Generate 32 bytes with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# Google Cloud Web application credentials. Enable gmail.googleapis.com and
# gmailmcp.googleapis.com, then add the redirect URI shown above.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
