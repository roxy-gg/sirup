{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./app/src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["app/src/**/*.ts", "app/src/**/*.tsx", "shared/**/*.ts", "vite.config.ts"]
}
